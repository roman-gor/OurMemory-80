{
  "rules": {
    "OurMemory": {
      "Users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "favorites": {
            "$veteranId": {
              ".validate": "newData.val() === true"
            }
          }
        }
      },
      "Admins": {
        ".read": "auth != null && root.child('OurMemory/SuperAdmins/' + auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && $uid !== auth.uid && root.child('OurMemory/SuperAdmins/' + auth.uid).exists()",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      },
      "Veterans": {
        ".read": true,
        ".write": "auth != null && root.child('OurMemory/Admins/' + auth.uid).exists()"
      },
      "Burials": {
        ".read": true,
        ".write": "auth != null && root.child('OurMemory/Admins/' + auth.uid).exists()"
      },
      "Tours": {
        ".read": true,
        ".write": "auth != null && root.child('OurMemory/Admins/' + auth.uid).exists()"
      },
      "Candles": {
        ".read": true,
        "$veteranId": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "Submissions": {
        ".read": "auth != null && (root.child('OurMemory/Admins/' + auth.uid).exists() || (query.orderByChild === 'authorUid' && query.equalTo === auth.uid))",
        "$submissionId": {
          ".write": "auth != null && (!data.exists() || root.child('OurMemory/Admins/' + auth.uid).exists())",
          ".validate": "root.child('OurMemory/Admins/' + auth.uid).exists() || (newData.hasChildren(['id', 'veteranId', 'text', 'contact', 'status', 'createdAt']) && newData.child('id').val() === $submissionId && newData.child('authorUid').val() === auth.uid && newData.child('status').val() === 'pending' && newData.child('text').isString() && newData.child('text').val().length <= 5000 && newData.child('createdAt').val() === now)"
        },
        ".indexOn": [
          "authorUid"
        ]
      },
      "Feedback": {
        ".read": "auth != null && (root.child('OurMemory/Admins/' + auth.uid).exists() || (query.orderByChild === 'authorUid' && query.equalTo === auth.uid))",
        "$feedbackId": {
          ".write": "auth != null && (!data.exists() || root.child('OurMemory/Admins/' + auth.uid).exists())",
          ".validate": "root.child('OurMemory/Admins/' + auth.uid).exists() || (newData.hasChildren(['id', 'type', 'text', 'status', 'createdAt']) && newData.child('id').val() === $feedbackId && newData.child('authorUid').val() === auth.uid && newData.child('status').val() === 'new' && newData.child('text').isString() && newData.child('text').val().length <= 3000 && newData.child('createdAt').val() === now)"
        },
        ".indexOn": [
          "authorUid"
        ]
      },
      "SuperAdmins": {
        ".read": "auth != null && root.child('OurMemory/SuperAdmins/' + auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "Accounts": {
        ".read": "auth != null && root.child('OurMemory/SuperAdmins/' + auth.uid).exists()",
        "$emailKey": {
          ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',')",
          ".validate": "newData.child('uid').val() === auth.uid && newData.child('email').val() === auth.token.email"
        }
      }
    }
  }
}
